# ========================================================
# PEDIDOS360 - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# NOTA DE SEGURIDAD: Nunca incluir credenciales reales ni tokens en este archivo.
# Duplique este archivo como .env para desarrollo local o despliegue.
# ========================================================

# --------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (CLOUD / LOCAL)
# --------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pedidos360
DB_USERNAME=pedidos_user
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA_EJEMPLO

# --------------------------------------------------------
# 2. CLÚSTER DE RABBITMQ (EP3 / EP4)
# --------------------------------------------------------
RABBITMQ_HOSTS=localhost:5672,localhost:5673
RABBITMQ_USERNAME=pedidos_admin
RABBITMQ_PASSWORD=CAMBIAR_RABBITMQ_PASS_EJEMPLO
RABBITMQ_ERLANG_COOKIE=PEDIDOS360_COOKIE_EJEMPLO_2026

# --------------------------------------------------------
# 3. CLÚSTER DE APACHE KAFKA & ZOOKEEPER (EP5 / EP6)
# --------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
ZOOKEEPER_CONNECT=localhost:2181,localhost:2182,localhost:2183
KAFKA_TOPIC_ORDERS=pedidos.order.events
KAFKA_TOPIC_AUDIT=pedidos.audit.events
KAFKA_UI_PORT=8085

# --------------------------------------------------------
# 4. MICROSOFT ENTRA ID / IDaaS & JWT
# --------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AUDIENCE=api://00000000-0000-0000-0000-000000000000
AZURE_JWK_SET_URI=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/keys
AZURE_ISSUER=https://sts.windows.net/00000000-0000-0000-0000-000000000000/

# --------------------------------------------------------
# 5. SERVICIOS FRONTEND Y BACKEND
# --------------------------------------------------------
BACKEND_PORT=8080
BACKEND_API_URL=http://localhost:8080
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200
